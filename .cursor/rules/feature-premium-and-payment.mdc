### 6. Modify Quiz Access to Check Premium Status

Update your quiz component to check if the user has access to premium quizzes:

```typescript
// quiz.component.ts
import { Component, OnInit } from '@angular/core';
import { ActivatedRoute, Router } from '@angular/router';
import { QuizService } from '../services/quiz.service';
import { PremiumService } from '../services/premium.service';

@Component({
  selector: 'app-quiz',
  templateUrl: './quiz.component.html',
  styleUrls: ['./quiz.component.scss']
})
export class QuizComponent implements OnInit {
  quizId: number;
  quiz: any = null;
  loading = true;
  error = '';
  premiumRequired = false;
  requiredPlanName = '';

  constructor(
    private route: ActivatedRoute,
    private router: Router,
    private quizService: QuizService,
    private premiumService: PremiumService
  ) { }

  ngOnInit(): void {
    this.quizId = +this.route.snapshot.paramMap.get('id');
    this.checkQuizAccess();
  }

  checkQuizAccess(): void {
    this.premiumService.checkQuizAccess(this.quizId).subscribe(
      (data) => {
        if (data.has_access) {
          // User has access, load the quiz
          this.loadQuiz();
        } else {
          // User doesn't have access, show premium required message
          this.loading = false;
          this.premiumRequired = true;
          this.requiredPlanName = data.required_plan_name;
        }
      },
      (error) => {
        this.error = 'Failed to check quiz access';
        this.loading = false;
        console.error(error);
      }
    );
  }

  loadQuiz(): void {
    this.quizService.getQuiz(this.quizId).subscribe(
      (data) => {
        this.quiz = data;
        this.loading = false;
      },
      (error) => {
        this.error = 'Failed to load quiz';
        this.loading = false;
        console.error(error);
      }
    );
  }

  goToPremiumPlans(): void {
    this.router.navigate(['/premium-plans']);
  }
}
```

