### 4. Create Payment Callback Component

Create a component to handle payment callbacks:

```typescript
// payment-callback.component.ts
import { Component, OnInit } from '@angular/core';
import { ActivatedRoute, Router } from '@angular/router';
import { PremiumService } from '../services/premium.service';

@Component({
  selector: 'app-payment-callback',
  templateUrl: './payment-callback.component.html',
  styleUrls: ['./payment-callback.component.scss']
})
export class PaymentCallbackComponent implements OnInit {
  status = 'checking';
  message = 'Checking payment status...';
  error = '';

  constructor(
    private route: ActivatedRoute,
    private router: Router,
    private premiumService: PremiumService
  ) { }

  ngOnInit(): void {
    // Get transaction ID from local storage
    const transactionId = localStorage.getItem('pending_transaction_id');
    
    if (!transactionId) {
      this.status = 'error';
      this.error = 'No pending transaction found';
      return;
    }
    
    // Check payment status
    this.premiumService.checkPaymentStatus(transactionId).subscribe(
      (data) => {
        if (data.status === 'Completed') {
          this.status = 'success';
          this.message = 'Payment successful! You are now subscribed.';
          
          // Remove transaction ID from local storage
          localStorage.removeItem('pending_transaction_id');
          
          // Redirect to premium content after 3 seconds
          setTimeout(() => {
            this.router.navigate(['/premium']);
          }, 3000);
        } else if (data.status === 'Pending') {
          this.status = 'pending';
          this.message = 'Payment is still being processed. Please wait...';
          
          // Check again after 5 seconds
          setTimeout(() => {
            this.ngOnInit();
          }, 5000);
        } else {
          this.status = 'error';
          this.error = `Payment ${data.status.toLowerCase()}. Please try again.`;
          
          // Remove transaction ID from local storage
          localStorage.removeItem('pending_transaction_id');
        }
      },
      (error) => {
        this.status = 'error';
        this.error = 'Failed to check payment status';
        console.error(error);
      }
    );
  }
}
```

