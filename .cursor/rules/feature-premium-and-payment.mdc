## Frontend Integration Guide for Premium Features

### 1. Display Premium Plans

First, you need to display the available premium plans to users:

```typescript
// Angular service
import { Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';

@Injectable({
  providedIn: 'root'
})
export class PremiumService {
  private apiUrl = 'http://your-backend-url/api';

  constructor(private http: HttpClient) { }

  // Get all premium plans
  getPremiumPlans(): Observable<any> {
    return this.http.get(`${this.apiUrl}/premium/plans`);
  }

  // Get user's active subscription
  getActiveSubscription(): Observable<any> {
    return this.http.get(`${this.apiUrl}/premium/subscriptions/active`);
  }

  // Create payment for a plan
  createPayment(planId: number, redirectUrl: string): Observable<any> {
    const userId = localStorage.getItem('user_id'); // Get user ID from local storage
    return this.http.post(`${this.apiUrl}/payment/create`, {
      user_id: userId,
      plan_id: planId,
      redirect_url: redirectUrl
    });
  }

  // Check payment status
  checkPaymentStatus(transactionId: string): Observable<any> {
    return this.http.get(`${this.apiUrl}/payment/check/${transactionId}`);
  }

  // Check if user has access to a quiz
  checkQuizAccess(paketSoalId: number): Observable<any> {
    return this.http.get(`${this.apiUrl}/premium/quiz-access/check/${paketSoalId}`);
  }
}
```

### 2. Create Premium Plans Component

Create a component to display premium plans:

```typescript
// premium-plans.component.ts
import { Component, OnInit } from '@angular/core';
import { PremiumService } from '../services/premium.service';
import { Router } from '@angular/router';

@Component({
  selector: 'app-premium-plans',
  templateUrl: './premium-plans.component.html',
  styleUrls: ['./premium-plans.component.scss']
})
export class PremiumPlansComponent implements OnInit {
  plans: any[] = [];
  activeSubscription: any = null;
  loading = true;
  error = '';

  constructor(
    private premiumService: PremiumService,
    private router: Router
  ) { }

  ngOnInit(): void {
    this.loadPlans();
    this.checkActiveSubscription();
  }

  loadPlans(): void {
    this.premiumService.getPremiumPlans().subscribe(
      (data) => {
        this.plans = data;
        this.loading = false;
      },
      (error) => {
        this.error = 'Failed to load premium plans';
        this.loading = false;
        console.error(error);
      }
    );
  }

  checkActiveSubscription(): void {
    this.premiumService.getActiveSubscription().subscribe(
      (data) => {
        this.activeSubscription = data;
      },
      (error) => {
        if (error.status !== 404) {
          console.error(error);
        }
      }
    );
  }

  subscribeToPlan(planId: number): void {
    // Create a payment for the selected plan
    const redirectUrl = `${window.location.origin}/payment/callback`;
    this.premiumService.createPayment(planId, redirectUrl).subscribe(
      (data) => {
        // Store transaction ID in local storage for later verification
        localStorage.setItem('pending_transaction_id', data.transaction_id);
        
        // Redirect to payment page
        window.location.href = data.payment_link;
      },
      (error) => {
        this.error = 'Failed to create payment';
        console.error(error);
      }
    );
  }
}
```

